{
	"info": {
		"_postman_id": "1234567-89ab-cdef-0123-456789abcdef",
		"name": "Kannect Journal API",
		"description": "API collection for journaling, habit tracking, goal planning, and sentiment analysis",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		},
		{
			"key": "access_token",
			"value": "your_access_token_here"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"user_name\": \"username\",\n    \"password\": \"password123\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal/auth/register",
							"host": ["{{base_url}}"],
							"path": ["journal", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "user@example.com"
								},
								{
									"key": "password",
									"value": "password123"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/journal/auth/login",
							"host": ["{{base_url}}"],
							"path": ["journal", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Journal Entries",
			"item": [
				{
					"name": "Create Entry",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Today was a great day!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal/entries",
							"host": ["{{base_url}}"],
							"path": ["journal", "entries"]
						}
					}
				},
				{
					"name": "Get All Entries",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/journal/entries?skip=0&limit=100",
							"host": ["{{base_url}}"],
							"path": ["journal", "entries"],
							"query": [
								{
									"key": "skip",
									"value": "0"
								},
								{
									"key": "limit",
									"value": "100"
								}
							]
						}
					}
				},
				{
					"name": "Get Entry",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/journal/entries/{id}",
							"host": ["{{base_url}}"],
							"path": ["journal", "entries", "{id}"]
						}
					}
				},
				{
					"name": "Update Entry",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Updated journal entry content\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/journal/entries/{id}",
							"host": ["{{base_url}}"],
							"path": ["journal", "entries", "{id}"]
						}
					}
				},
				{
					"name": "Delete Entry",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/journal/entries/{id}",
							"host": ["{{base_url}}"],
							"path": ["journal", "entries", "{id}"]
						}
					}
				}
			]
		},
